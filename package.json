{
  "name": "parentsave-extension",
  "version": "1.0.0",
  "description": "Smart coupons, price tracking, and safety alerts for parents",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint lib/ background/ content/ popup/ options/",
    "lint:fix": "eslint lib/ background/ content/ popup/ options/ --fix",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "validate": "web-ext lint --source-dir=./",
    "package": "web-ext build --source-dir=./ --artifacts-dir=./dist --overwrite-dest"
  },
  "keywords": [
    "chrome-extension",
    "parenting",
    "coupons",
    "baby",
    "savings",
    "recalls"
  ],
  "author": "ParentSave",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "web-ext": "^7.8.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "injectGlobals": true,
    "moduleFileExtensions": ["js", "json"],
    "testMatch": ["../__tests__/**/*.test.js"],
    "collectCoverageFrom": [
      "lib/**/*.js",
      "!lib/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov"],
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "setupFilesAfterEnv": ["../__tests__/jest.setup.js"]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "webextensions": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
      "no-console": "off"
    },
    "globals": {
      "chrome": "readonly"
    }
  }
}
